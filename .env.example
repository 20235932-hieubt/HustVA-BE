PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional: absolute CRAWL_DATA_DIR for storing crawl results.
# Default is <repo>/.local/crawler, no Docker needed for crawler local mode.

# MongoDB Atlas for knowledge, vectors and future agent memory.
# Used by db:check / db:setup; optional for the current file-based crawler.
# See docs/development/cloud-databases.md.
MONGODB_URI=
MONGODB_DB_NAME=hustva_dev
MONGODB_VECTOR_INDEX=knowledge_vector_v1
# Set only after choosing an embedding model; do not guess the dimension.
EMBEDDING_DIMENSION=
EMBEDDING_SIMILARITY=cosine
