PORT=4000
# Listen address: use 0.0.0.0 inside a deployed container.
HOST=127.0.0.1
# Public backend origin (no /api/v1). Also permits this hostname for chat routes.
API_ORIGIN=http://localhost:4000
# Origin of the chatbot frontend/iframe, not the website embedding the widget.
WEB_ORIGIN=http://localhost:3000
# JSON logs to stdout: debug | info | warn | error | silent.
LOG_LEVEL=info
# Optional: absolute CRAWL_DATA_DIR for storing crawl results.
# Default is <repo>/.local/crawler, no Docker needed for crawler local mode.

# MongoDB Atlas for knowledge, vectors and future agent memory.
# Used by db:check / db:setup; optional for the current file-based crawler.
# See docs/development/cloud-databases.md.
MONGODB_URI=
MONGODB_DB_NAME=hustva_dev
MONGODB_VECTOR_INDEX=knowledge_vector_v1
# dangvantuan/vietnamese-document-embedding produces 768-dimensional vectors.
EMBEDDING_DIMENSION=768
EMBEDDING_SIMILARITY=cosine

# Gemini chatbot. Set a model enabled for your Google AI Studio project.
GEMINI_API_KEY=
# Optional comma-separated keys. Non-empty list replaces GEMINI_API_KEY; blank keeps legacy key.
GEMINI_API_KEYS=
# Shared by routing + answer generation, including failed attempts (1-15).
GEMINI_MAX_REQUESTS_PER_MINUTE=15
# All keys pause on 429; transient failures cool down only the affected key.
GEMINI_KEY_COOLDOWN_MS=60000
# Total attempts per invocation (1-3), still counted toward the shared RPM budget.
GEMINI_MAX_ATTEMPTS=2
GEMINI_MODEL=
CHAT_TIMEOUT_MS=30000
CHAT_MAX_TOOL_ROUNDS=3
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_MODEL_CALLS=4
CHAT_MAX_TURN_TOKENS=24000
# Requires demo login and a matching account-to-student mapping for private chat.
# Management must also enable each grade tool. This flag does not authenticate students.
CHAT_GRADES_ENABLED=false
# Independent release flag for private exam schedules. Also enable get_exams in management.
# Requires demo login; current-semester lookup needs get_semesters and at least two tool calls/rounds.
CHAT_EXAMS_ENABLED=false
# Public teacher/company research topics. Enable the two topic tools separately in management.
CHAT_TOPICS_ENABLED=false
# Multi-turn tool argument collection; independent from individual tool release flags.
CHAT_MULTI_TURN_TOOLS_ENABLED=false

# Demo accounts are provisioned locally; this is not Microsoft/HUST sign-in.
DEMO_AUTH_ENABLED=false
# Relative to the backend working directory, or an absolute server-side path.
DEMO_ACCOUNTS_FILE=.local/demo-auth/accounts.json
DEMO_SESSION_TTL_MS=3600000

# Embedding: every document the crawler saves is embedded right away (see README).
# Set EMBEDDING_ENABLED=false to crawl without embedding.
EMBEDDING_ENABLED=true
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
# Where chunks + vectors are stored: local (JSON in .local/embedding) or atlas
# (MongoDB Atlas knowledge_chunks + Vector Search; needs MONGODB_URI, EMBEDDING_DIMENSION=768
# and one run of `pnpm db:setup`). Switching store re-embeds everything on the next reconcile.
EMBEDDING_STORE=local
# Optional: absolute EMBEDDING_DATA_DIR; default <repo>/.local/embedding
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_RECONCILE_INTERVAL_MS=300000
# RAG: passages scoring below this cosine similarity are ignored by the chatbot tools.
# RAG_MIN_SCORE=0.45

# System One decision model (services/system-one, Laya on 127.0.0.1:8002).
# Master switch: off | shadow (decide + record to evals/runs, no effect) | on.
# Each site also needs its own flag set to exactly `true`. Any invalid value
# turns System One off entirely; the chat keeps working without it.
SYSTEM_ONE_MODE=off
SYSTEM_ONE_INPUT_GATE=false
SYSTEM_ONE_TOOL_SKIP=false
SYSTEM_ONE_CLARIFY=false
SYSTEM_ONE_CLAIM_CHECK=false
SYSTEM_ONE_UNIT_HINT=false
SYSTEM_ONE_RELEVANCE=false
# laya (local) | jev | clef. jev/clef send content to a third party (https only,
# need SYSTEM_ONE_API_KEY); not approved for student data yet.
SYSTEM_ONE_PROVIDER=laya
SYSTEM_ONE_URL=http://127.0.0.1:8002
# SYSTEM_ONE_MODEL=jev-latest
# SYSTEM_ONE_API_KEY=
# 100-5000 ms; on timeout the turn takes the old path.
SYSTEM_ONE_TIMEOUT_MS=1500

HUST_BASE_API_URL=
HUST_API_TOKEN=
HUST_AUTHORIZATION_TOKEN=
TOOL_MANAGEMENT_TOKEN=
# Optional approved student ID for authenticated management profile calls only.
# Chat always uses the logged-in account mapping, never this shared fallback.
DEMO_STUDENT_ID=
