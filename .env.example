PORT=4000
# Listen address: use 0.0.0.0 inside a deployed container.
HOST=127.0.0.1
# Public backend origin (no /api/v1). Also permits this hostname for chat routes.
API_ORIGIN=http://localhost:4000
# Origin of the chatbot frontend/iframe, not the website embedding the widget.
WEB_ORIGIN=http://localhost:3000
# JSON logs to stdout: debug | info | warn | error | silent.
LOG_LEVEL=info
# Optional: absolute CRAWL_DATA_DIR for storing crawl results.
# Default is <repo>/.local/crawler, no Docker needed for crawler local mode.

# MongoDB Atlas for knowledge, vectors and future agent memory.
# Used by db:check / db:setup; optional for the current file-based crawler.
# See docs/development/cloud-databases.md.
MONGODB_URI=
MONGODB_DB_NAME=hustva_dev
MONGODB_VECTOR_INDEX=knowledge_vector_v1
# dangvantuan/vietnamese-document-embedding produces 768-dimensional vectors.
EMBEDDING_DIMENSION=768
EMBEDDING_SIMILARITY=cosine

# Gemini chatbot. Set a model enabled for your Google AI Studio project.
GEMINI_API_KEY=
GEMINI_MODEL=
CHAT_TIMEOUT_MS=30000
CHAT_MAX_TOOL_ROUNDS=3
CHAT_MAX_TOOL_CALLS=6
CHAT_MAX_MODEL_CALLS=4
CHAT_MAX_TURN_TOKENS=24000

# Embedding: every document the crawler saves is embedded right away (see README).
# Set EMBEDDING_ENABLED=false to crawl without embedding.
EMBEDDING_ENABLED=true
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
# Where chunks + vectors are stored: local (JSON in .local/embedding) or atlas
# (MongoDB Atlas knowledge_chunks + Vector Search; needs MONGODB_URI, EMBEDDING_DIMENSION=768
# and one run of `pnpm db:setup`). Switching store re-embeds everything on the next reconcile.
EMBEDDING_STORE=local
# Optional: absolute EMBEDDING_DATA_DIR; default <repo>/.local/embedding
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_RECONCILE_INTERVAL_MS=300000
# RAG: passages scoring below this cosine similarity are ignored by the chatbot tools.
# RAG_MIN_SCORE=0.45

HUST_BASE_API_URL=
HUST_API_TOKEN=
HUST_AUTHORIZATION_TOKEN=
TOOL_MANAGEMENT_TOKEN=
